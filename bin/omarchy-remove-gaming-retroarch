#!/bin/bash

# omarchy:summary=Remove RetroArch, all libretro cores, and its config/saves. Leaves ~/Games/roms and ~/Games/bios alone.
# omarchy:requires-sudo=true

set -e

omarchy-pkg-drop \
  retroarch \
  retroarch-assets retroarch-database retroarch-filters \
  libretro-beetle-ngp libretro-beetle-pce-fast libretro-beetle-vb libretro-beetle-wswan \
  libretro-bsnes-mercury \
  libretro-gambatte \
  libretro-handy \
  libretro-mgba \
  libretro-nestopia \
  libretro-pcsx-rearmed \
  libretro-prosystem \
  libretro-stella2014

rm -rf \
  "$HOME/.config/retroarch" \
  "$HOME/.local/share/retroarch" \
  "$HOME/.cache/retroarch"

echo ""
echo "RetroArch and its cores have been removed."
echo "ROMs and BIOS files at ~/Games/roms and ~/Games/bios were left in place."
