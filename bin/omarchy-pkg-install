#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking new Fedora packages to install.
# omarchy:requires-sudo=true

fzf_args=(
  --multi
  --preview 'dnf --quiet info --available {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

# --assumeyes auto-accepts repo GPG key imports; otherwise dnf5 prompts and
# hangs because stdin is captured by the fzf pipeline.
# %{name}\n is required: without the trailing newline dnf5 concatenates names.
pkg_names=$(dnf --quiet --assumeyes repoquery --queryformat '%{name}\n' | sort -u | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  source omarchy-sudo-keepalive

  # Convert newline-separated selections to space-separated for dnf
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo dnf install -y
  omarchy-show-done
fi
