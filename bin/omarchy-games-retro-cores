#!/bin/bash

# omarchy:summary=List installed RetroArch core names

set -e

core_dir="/usr/lib64/libretro"
preferred_cores=(
  "Atari 2600|stella2014"
  "Atari 5200|prosystem"
  "Atari 7800|prosystem"
  "Atari Lynx|handy"
  "Bandai WonderSwan / Color|mednafen_wswan"
  "NEC PC Engine / TurboGrafx-16|mednafen_pce_fast"
  "Nintendo Game Boy / Color|gambatte"
  "Nintendo Game Boy Advance|mgba"
  "Nintendo NES / Famicom|nestopia"
  "Nintendo SNES / SFC|bsnes-mercury_performance"
  "Nintendo Virtual Boy|mednafen_vb"
  "SNK Neo Geo Pocket / Color|mednafen_ngp"
  "Sony PlayStation|pcsx_rearmed"
)

[[ -d $core_dir ]] || exit 0

for preferred_core in "${preferred_cores[@]}"; do
  label="${preferred_core%%|*}"
  core="${preferred_core#*|}"
  [[ -f $core_dir/${core}.libretro ]] && printf '%s (%s)\n' "$label" "$core"
done
